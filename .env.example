# Local profile
APP_ENV=local
RAG_API_BASE_URL=http://127.0.0.1:8765
DEMO_RUNTIME_ROOT=demo-ui/runtime
DEMO_DATA_CLASSIFICATION=Synthetic / Public
DEMO_ALLOW_RAG_QUERY=true
DEMO_REQUEST_TIMEOUT_SECONDS=45
RAG_RETRY_LIMIT=0
MAX_LLM_CALLS_PER_SESSION=unlimited
RAG_PUBLIC_CORPUS_ROOT=public_corpus_paddleocr
RAG_PUBLIC_RETRIEVAL_CONFIG=public_corpus_paddleocr/public_retrieval_runtime.json
RD_V2_ALLOW_EXTERNAL_GENERATION=true
RD_V2_GENERATION_PROVIDER=deepseek
RD_V2_GENERATION_MODEL=deepseek-v4-flash

# Public profile placeholders; set these in platform secret/configuration panels.
# APP_ENV=public_demo
# RAG_API_BASE_URL=https://<render-service>
# DEEPSEEK_API_KEY=<set-in-platform-secret-store>
